LAMMPS (10 Sep 2025 - Development - patch_10Sep2025-457-gabba7fcf55)
# 512-atom silicon melting run at 3000 K and 0 bar

variable backend index direct
variable direct_plugin index ../../direct/build/tersoffnndirectplugin.so
variable torchscript_plugin index ../../torchscript/build/tersoffnnplugin.so

units metal
dimension 3
boundary p p p
atom_style atomic

if "${backend} == direct" then   "plugin load ${direct_plugin}" else   "plugin load ${torchscript_plugin}"
plugin load ${direct_plugin}
plugin load ../../direct/build/tersoffnndirectplugin.so
Loading plugin: Tersoff NN pair style with hand-written MLP inference by Yusuke Nishimura

lattice diamond 5.431
Lattice spacing in x,y,z = 5.431 5.431 5.431
region box block 0 4 0 4 0 4
create_box 1 box
Created orthogonal box = (0 0 0) to (21.724 21.724 21.724)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 512 atoms
  using lattice units in orthogonal box = (0 0 0) to (21.724 21.724 21.724)
  create_atoms CPU = 0.000 seconds
mass 1 28.0855

if "${backend} == direct" then   "pair_style tersoff_nn_direct model_name ../../models/JSAP_autumn_2026/model_direct.txt input_stats ../../models/JSAP_autumn_2026/input_stats.csv use_gpu no" else   "pair_style tersoff_nn model_name ../../models/JSAP_autumn_2026/model_ts.pt input_stats ../../models/JSAP_autumn_2026/input_stats.csv use_gpu no"
pair_style tersoff_nn_direct model_name ../../models/JSAP_autumn_2026/model_direct.txt input_stats ../../models/JSAP_autumn_2026/input_stats.csv use_gpu no
pair_coeff * * ../../models/JSAP_autumn_2026/Si.tersoff Si_NN
Reading tersoff_nn potential file ../../models/JSAP_autumn_2026/Si.tersoff with DATE: 2011-04-26

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

velocity all create 3000.0 4928459 mom yes rot no dist gaussian
fix ensemble all npt temp 3000.0 3000.0 0.1 iso 0.0 0.0 1.0

compute coordination all coord/atom cutoff 3.0
compute mean_coordination all reduce ave c_coordination
dump trajectory all custom 100 trajectory.${backend}.dump id type element x y z
dump trajectory all custom 100 trajectory.direct.dump id type element x y z
dump_modify trajectory sort id element Si

timestep 0.001
thermo 100
thermo_style custom step temp pe ke etotal press density c_mean_coordination
run 1000
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 5.5
  ghost atom cutoff = 5.5
  binsize = 2.75, bins = 8 8 8
  2 neighbor lists, perpetual/occasional/extra = 1 1 0
  (1) pair tersoff_nn_direct, perpetual
      attributes: full, newton on
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
  (2) compute coord/atom, occasional, copy from (1)
      attributes: full, newton on
      pair build: copy
      stencil: none
      bin: none
